<?xml version="1.0" encoding="utf-8"?>
<!--
  The wizard's two pictures.

  jpackage has no resource of its own for these: its MSI is built on WiX's
  WixUI_InstallDir, and the banner and the side panel come from bitmaps baked
  into WixUIExtension. This file is the hook jpackage does offer - it is
  included into the generated main.wxs - so the two WiX variables are set here
  instead.

  The paths have to be absolute by the time WiX compiles, and the compiler runs
  in a temporary directory, so packaging\package.bat writes overrides.wxi from
  this template with @ART@ replaced by the real location.
-->
<Include>
  <WixVariable Id="WixUIBannerBmp" Value="@ART@\banner.bmp" />
  <WixVariable Id="WixUIDialogBmp" Value="@ART@\dialog.bmp" />
</Include>
